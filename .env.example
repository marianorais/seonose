# Variables de entorno de Se o NoSe (frontend, Vite).
# Todas son públicas: terminan dentro del JavaScript que descarga el navegador.
# NUNCA pongas acá la service_role key ni contraseñas.

# Proyecto de Supabase (Settings > API).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: dominio canónico para links compartidos (por defecto https://www.seonose.com.ar).
# Útil en previews de Vercel.
# VITE_SITE_URL=https://www.seonose.com.ar

# Opcional: Google Analytics 4. Sin esta variable no se carga ninguna analítica.
# Aunque esté definida, sólo mide en el dominio de producción (no en localhost
# ni en previews de Vercel). Para verificar en DebugView: https://www.seonose.com.ar/?ga_debug=1
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
